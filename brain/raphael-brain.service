# Raphael Brain — systemd unit (WSL2, systemd-enabled distro) — OPTIONAL.
#
# Process mode (supervisor `brain_mode: auto`) stays the default: the
# supervisor spawns uvicorn root-less and this unit is only used if/when it
# is installed (supervisor auto-detects `systemctl show LoadState`).
#
# Install (USER-run, needs sudo — agents never run this, AGENT_RULES §12):
#   Preferred:  scripts/install-brain-unit.sh [--now] [--sudoers]
#               (rewrites the hardcoded paths below to your actual repo,
#                validates, installs, daemon-reload; --now also starts)
#   Manual:     sudo cp brain/raphael-brain.service /etc/systemd/system/
#               sudo systemctl daemon-reload
#               sudo systemctl enable --now raphael-brain
#               sudo systemctl status raphael-brain
# Profile note (WAVES.md): NO Ollama dependency under `cloud_temp` — this
# unit must never pull or warm local models. Profile `local` may re-add the
# ollama dependency later via a drop-in (`systemctl edit raphael-brain`),
# never by editing this file.
[Unit]
Description=Raphael Brain (FastAPI loopback, agent loop, jobs, router, WS hub)
After=network.target

[Service]
Type=simple
User=<wsl-user>
WorkingDirectory=<repo-root>
Environment=PATH=<repo-root>/brain/.venv/bin:/usr/local/bin:/usr/bin:/bin
# Bind host: 127.0.0.1 in BOTH networking modes (network-security fix —
# Windows clients arrive via the supervisor relay / native localhost
# forwarding). Override with RAPHAEL_BIND (e.g. 0.0.0.0 only if the relay
# is disabled and native forwarding is verified) / RAPHAEL_PORT;
# RAPHAEL_INSTANCE derives the port (INTERFACES §d).
# See scripts/NETWORK-SECURITY.md.
ExecStart=<repo-root>/brain/.venv/bin/python -m brain.run
Restart=always
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGTERM
# SIGTERM path: workers cancel cleanly, non-terminal jobs journal as
# `interrupted` on the next start (PROTOCOL §5 — reported, never auto-resumed).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=raphael-brain
# Hardening (loopback-only service; token-gated)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
