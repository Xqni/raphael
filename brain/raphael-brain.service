# Raphael Brain — systemd unit TEMPLATE (WSL2, systemd-enabled distro).
# NOT installed here — installing needs root. To install later:
#   sudo cp brain/raphael-brain.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now raphael-brain
#   sudo systemctl status raphael-brain
[Unit]
Description=Raphael Brain (FastAPI :8765, agent loop, jobs, router, WS hub)
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=dami
WorkingDirectory=/home/dami/raphael
Environment=PATH=/home/dami/raphael/brain/.venv/bin:/usr/local/bin:/usr/bin:/bin
# Bind host auto-detected at startup (wslinfo: NAT -> 0.0.0.0, mirrored -> 127.0.0.1)
# Override with RAPHAEL_BIND / RAPHAEL_PORT if needed.
ExecStart=/home/dami/raphael/brain/.venv/bin/python -m brain.run
Restart=always
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGTERM
# SIGTERM path: workers cancel cleanly, non-terminal jobs journal as
# `interrupted` on the next start (PROTOCOL §5 — reported, never auto-resumed).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=raphael-brain
# Hardening (localhost-only service; token-gated)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
