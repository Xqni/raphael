# Raphael secrets — copy to .env and fill in. NEVER commit .env, NEVER paste values in chat.
# chmod 600 .env after editing.

# OpenCode Zen/Go API key (base URL https://opencode.ai/zen/v1 — same key for Go endpoint)
OPENCODE_API_KEY=

# GitHub token for Raphael's runtime repo creation (fine-grained, repo scope). Optional until GitHub tool is used.
GITHUB_TOKEN=

# WebSocket auth token location (generated by scripts/token-gen.sh — do not hand-edit)
RAPHAEL_TOKEN_PATH_WSL=/home/dami/.raphael/token
RAPHAEL_TOKEN_PATH_WIN=%APPDATA%\Raphael\token
